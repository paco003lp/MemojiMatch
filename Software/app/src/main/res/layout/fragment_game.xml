<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ms_background"
    android:padding="16dp"
    android:paddingTop="28dp">

    <!-- GORNJA TRAKA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_bar"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_label_time"
                android:textColor="@color/ms_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ms_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="0:42" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_badge"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/ms_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="MEDIUM" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_label_score"
                android:textColor="@color/ms_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/txtScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ms_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="0" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressTime"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/progress_timer" />

    <!-- GRID -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <GridLayout
            android:id="@+id/gridGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- DONJI RED -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/txtPairs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ms_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1/8 parova" />

        <TextView
            android:id="@+id/txtPenalty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_penalty"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/ms_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="-10 kazna" />
    </LinearLayout>

</LinearLayout>