<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.memojimatch.ui.profile.ProfileFragment"
        android:label="Profil">
        <action
            android:id="@+id/action_profile_to_main"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.memojimatch.fragments.LevelSelectFragment"
        android:label="Odaberi razinu"
        tools:layout="@layout/fragment_level_select" />

</navigation>